# Copie para .env (cp .env.example .env) e ajuste os valores.
# O .env NUNCA vai para o Git. Em producao, estes valores chegam
# pelos GitHub Secrets / Variables (ver .github/workflows/deploy.yml).
# Toda a leitura acontece em src/config/settings.py: se algo obrigatorio
# faltar, a API recusa a inicializacao e diz o que falta.

ENVIRONMENT=dev
CLIENT_URL=http://localhost:5173

# Banco de dados (mesmos valores do container local da cartilha)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=usuario
DB_PASSWORD=senha

# OBRIGATORIO - minimo de 16 caracteres (em producao, use um valor aleatorio longo)
USER_JWT_SECRET=troque-este-valor-local

# OPCIONAIS - preencha quando o projeto usar o recurso
HMAC_SECRET_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
